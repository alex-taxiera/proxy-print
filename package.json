{
  "name": "proxy-print",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run watch-css & vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "preview": "vite preview",
    "prepare": "panda codegen",
    "watch-css": "panda codegen --watch",
    "storybook": "npm run watch-css & storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^styled-system/(.*)$",
      "^[./]"
    ],
    "importOrderSeparation": true
  },
  "dependencies": {
    "@ark-ui/react": "^5.18.2",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^0.2.3",
    "jspdf": "github:laucheukhim/jsPDF",
    "nanoid": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.0",
    "@eslint/js": "^9.15.0",
    "@pandacss/dev": "^0.54.0",
    "@storybook/addon-a11y": "^9.1.0",
    "@storybook/addon-docs": "^9.1.0",
    "@storybook/addon-onboarding": "^9.1.0",
    "@storybook/addon-themes": "^9.1.0",
    "@storybook/addon-vitest": "^9.1.0",
    "@storybook/react-vite": "^9.1.0",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "effect": "^3.17.2",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "eslint-plugin-storybook": "^9.1.0",
    "globals": "^15.12.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.54.1",
    "prettier": "3.6.2",
    "storybook": "^9.1.0",
    "type-fest": "^4.41.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vitest": "^3.2.4"
  }
}
