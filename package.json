{
  "name": "proxy-print",
  "private": true,
  "version": "2.1.6",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run watch-chakra & vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "preview": "npm run build && wrangler dev",
    "typegen": "chakra typegen src/theme.ts",
    "prepare": "npm run typegen",
    "watch-chakra": "npm run typegen -- --watch",
    "storybook": "npm run watch-chakra & storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "deploy": "npm run build && wrangler deploy"
  },
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^@/components/ui/(.*)$",
      "^@/components/(.*)$",
      "^@/(.*)$",
      "^[./]"
    ],
    "importOrderSeparation": true
  },
  "dependencies": {
    "@chakra-ui/react": "^3.35.0",
    "@dnd-kit/helpers": "^0.1.21",
    "@dnd-kit/react": "^0.1.21",
    "@emotion/react": "^11.14.0",
    "@floating-ui/react": "^0.27.19",
    "@scryfall/api-types": "^1.0.0-alpha.4",
    "@sentry/react": "^10.56.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@tanstack/react-query": "^5.101.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "idb-keyval": "^6.2.5",
    "jszip": "^3.10.1",
    "nanoid": "^5.1.11",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.35.0",
    "@cloudflare/vite-plugin": "^1.42.1",
    "@eslint/js": "^9.39.4",
    "@storybook/addon-a11y": "10.4.2",
    "@storybook/addon-docs": "10.4.2",
    "@storybook/addon-onboarding": "10.4.2",
    "@storybook/addon-themes": "10.4.2",
    "@storybook/addon-vitest": "10.4.2",
    "@storybook/react-vite": "10.4.2",
    "@tanstack/eslint-plugin-query": "^5.101.0",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "10.4.2",
    "globals": "^17.6.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.60.0",
    "prettier": "3.8.3",
    "storybook": "10.4.2",
    "type-fest": "^5.7.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.103.0"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.28.1": true,
    "@sentry/cli@2.58.6": true,
    "core-js@3.29.1": true,
    "sharp@0.34.5": true,
    "workerd@1.20260617.1": true
  }
}
