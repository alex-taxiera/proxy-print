{
  "name": "proxy-print",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run watch-chakra & vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "preview": "vite preview",
    "typegen": "chakra typegen src/theme.ts",
    "prepare": "npm run typegen",
    "watch-chakra": "npm run typegen -- --watch",
    "storybook": "npm run watch-chakra & storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui"
  },
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "^@/components/ui/(.*)$",
      "^@/components/(.*)$",
      "^@/(.*)$",
      "^[./]"
    ],
    "importOrderSeparation": true
  },
  "dependencies": {
    "@ark-ui/react": "^5.18.4",
    "@chakra-ui/react": "^3.35.0",
    "@dnd-kit/helpers": "^0.1.21",
    "@dnd-kit/react": "^0.1.21",
    "@emotion/react": "^11.14.0",
    "@floating-ui/react": "^0.27.19",
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^0.2.3",
    "@scryfall/api-types": "^1.0.0-alpha.4",
    "@sentry/react": "^10.5.0",
    "@sentry/vite-plugin": "^4.1.1",
    "@tanstack/react-query": "^5.85.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "idb-keyval": "^6.2.2",
    "jszip": "^3.10.1",
    "nanoid": "^5.1.5",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.6.0",
    "zod": "^4.0.17",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.35.0",
    "@chromatic-com/storybook": "^4.1.0",
    "@eslint/js": "^9.33.0",
    "@pandacss/dev": "^0.54.0",
    "@storybook/addon-a11y": "^9.1.2",
    "@storybook/addon-docs": "^9.1.2",
    "@storybook/addon-onboarding": "^9.1.2",
    "@storybook/addon-themes": "^9.1.2",
    "@storybook/addon-vitest": "^9.1.2",
    "@storybook/react-vite": "^9.1.2",
    "@tanstack/eslint-plugin-query": "^5.83.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "effect": "^3.17.7",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "eslint-plugin-storybook": "^9.1.2",
    "globals": "^15.15.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.54.2",
    "prettier": "3.6.2",
    "storybook": "^9.1.2",
    "type-fest": "^4.41.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
