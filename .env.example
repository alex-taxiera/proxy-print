# Copy to `.env.local` and fill in as needed. Every value is optional —
# the app runs fine with none of them set.

# Sentry DSN. Leave empty to disable error reporting entirely.
VITE_SENTRY_DSN=

# Environment name reported to Sentry. Defaults to Vite's MODE.
# `production` lowers the trace sample rate from 1.0 to 0.1.
VITE_SENTRY_ENV=development

# Comma-separated hosts used as mirrors in place of `cards.scryfall.io`
# when fetching Scryfall art. Tried before the canonical URL.
VITE_CLOUDFLARE_ORIGINS=
