{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proxy-print",
  "compatibility_date": "2026-06-23",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "staging": {
      "workers_dev": true,
      "routes": [
        "dev.printmyproxy.com",
        "dev-proxyprint.taxiera.net/*",
        "devprint.taxiera.net/*",
      ],
    },
    "production": {
      "workers_dev": true,
      "routes": ["printmyproxy.com/*", "proxyprint.taxiera.net/*"],
    },
  },
}
