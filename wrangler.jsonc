{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Renaming this creates a new Worker and drops the custom domain bindings
  // below, so it stays on the pre-rebrand slug. The product is "Print My Proxy".
  "name": "proxy-print",
  "compatibility_date": "2026-06-23",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "staging": {
      "workers_dev": true,
      "preview_urls": true,
      "routes": [
        {
          "pattern": "dev.printmyproxy.com",
          "custom_domain": true,
        },
        // Legacy pre-rebrand domains, kept bound so old links keep working.
        {
          "pattern": "dev-proxyprint.taxiera.net",
          "custom_domain": true,
        },
        {
          "pattern": "devprint.taxiera.net",
          "custom_domain": true,
        },
      ],
    },
    "production": {
      "workers_dev": true,
      "routes": [
        {
          "pattern": "printmyproxy.com",
          "custom_domain": true,
        },
        // Legacy pre-rebrand domain, kept bound so old links keep working.
        {
          "pattern": "proxyprint.taxiera.net",
          "custom_domain": true,
        },
      ],
    },
  },
}
