{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proxy-print",
  "compatibility_date": "2026-06-23",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "not_found_handling": "single-page-application",
  },
  "compatibility_flags": ["nodejs_compat"],
  "env": {
    "staging": {
      "workers_dev": true,
      "routes": [
        {
          "pattern": "dev.printmyproxy.com/*",
          "custom_domain": true,
        },
        {
          "pattern": "dev-proxyprint.taxiera.net/*",
          "custom_domain": true,
        },
        {
          "pattern": "devprint.taxiera.net/*",
          "custom_domain": true,
        },
      ],
    },
    "production": {
      "workers_dev": true,
      "routes": [
        {
          "pattern": "printmyproxy.com/*",
          "custom_domain": true,
        },
        {
          "pattern": "proxyprint.taxiera.net/*",
          "custom_domain": true,
        },
      ],
    },
  },
}
